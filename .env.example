# Environment Configuration
# Copy this to .env and fill in your values

# ─── Application ───
APP_NAME=evidence-aware-research-assistant
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# ─── Backend ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── PostgreSQL ───
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=literature_review
POSTGRES_USER=litreview
POSTGRES_PASSWORD=litreview_dev_password
DATABASE_URL=postgresql+asyncpg://litreview:litreview_dev_password@postgres:5432/literature_review

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Qdrant ───
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=paper_chunks

# ─── MinIO (S3-compatible) ───
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=research-papers
S3_REGION=us-east-1

# ─── LLM Provider (OpenRouter / Hugging Face / NVIDIA / Groq / Gemini) ───
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Hugging Face (Alternative)
HF_API_KEY=hf_your-key-here
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# NVIDIA NIM (Alternative)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Groq API (Alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Embedding Model ───
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Upload Limits ───
MAX_UPLOAD_SIZE_MB=50
MAX_PAPERS_PER_SESSION=10
MIN_PAPERS_PER_SESSION=1

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
